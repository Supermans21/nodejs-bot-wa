# Nomor Owner (penerima semua hasil laporan & satu-satunya yang bisa memakai command //)
OWNER="628xxxxxxxxxx@s.whatsapp.net"

# Nomor Target utama (fitur otomatis hanya aktif untuk chat & status target ini)
TARGET_NUMBER="628xxxxxxxxxx"
TARGET_LID=""

# Opsional: isi nomor WA bot (angka saja) untuk login pakai Pairing Code tanpa QR
PAIRING_NUMBER=""

# Opsional: Tanggal jadian utama (format YYYY-MM-DD, bisa juga diubah langsung di WA via //set anniv)
ANNIV_DATE=""

# Auto-Cleanup SQLite: hapus cache pesan Anti-Delete/Edit lebih tua dari X hari (statistik couple & vault tetap aman)
DB_RETENTION_DAYS=7

# Opsional: Gemini API Key untuk fitur //ai, //vn, //kode, //ocr (https://aistudio.google.com/apikey)
# Bisa juga dipasang langsung dari chat WA via: //set gemini_key API_KEY_KAMU
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"
